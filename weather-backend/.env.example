# Environment
NODE_ENV=development

# WeatherAPI.com API Key
# Lấy key tại: https://www.weatherapi.com/
WEATHER_API_KEY=your_api_key_here

# Frontend URL for CORS
# Để trống nếu chạy localhost
FRONTEND_ORIGIN=http://localhost:5173

# Server Port
PORT=3001

# Cache Time-to-Live (milliseconds)
# Default: 600000 (10 phút)
# Thay đổi để kiểm soát thời gian cache dữ liệu weather
CACHE_TTL=600000
